# ReproProof Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env!

# Meta AI API Key (required for live model calls; leave empty for deterministic mock mode)
MODEL_API_KEY=

# Meta AI Base URL (OpenAI-compatible endpoint)
META_API_BASE_URL=https://api.meta.ai/v1

# Models
DEFAULT_MODEL=muse-spark-1.3
ESCALATION_MODEL=muse-wonder-1.0

# Runner limits
MAX_PATCH_ATTEMPTS=2
MAX_TOOL_STEPS=20
BROWSER_TIMEOUT_SECONDS=60
RUN_TIMEOUT_SECONDS=600
SPEND_LIMIT_USD=1.00
MAX_PATCH_LINES=200
MAX_PATCH_FILES=5
